<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Some machines configure a missing shared fallback folder (e.g. D:\VS2022\Shared\NuGetPackages)
       at the user/machine level, which makes restore fail with NU1301. Clearing fallback folders here
       keeps the build reproducible without changing the developer's global NuGet configuration. -->
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
