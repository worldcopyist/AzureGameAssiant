<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>AzureGameAssistant.Collector</RootNamespace>
    <AssemblyName>AzureGameAssistant.Collector</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AzureGameAssistant.Core\AzureGameAssistant.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\third_party\presentmon\PresentMon-2.6.0-x64.exe"
          Link="presentmon\PresentMon-2.6.0-x64.exe"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Condition="Exists('..\..\third_party\presentmon\PresentMon-2.6.0-x64.exe')" />
    <None Include="..\..\third_party\presentmon\LICENSE.txt"
          Link="presentmon\LICENSE.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Condition="Exists('..\..\third_party\presentmon\LICENSE.txt')" />
  </ItemGroup>
</Project>
