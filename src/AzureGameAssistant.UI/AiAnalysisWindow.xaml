<Window x:Class="AzureGameAssistant.UI.AiAnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:AzureGameAssistant.UI.Services"
        Title="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AiWindowTitle]}"
        Icon="pack://application:,,,/Assets/app-icon.ico"
        Width="780" Height="840" MinWidth="640" MinHeight="560"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="Detail" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>

        <Style x:Key="PreviewBox" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock Style="{StaticResource HeaderTitle}"
                       Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AiWindowTitle]}" />
            <TextBlock Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AiWindowSubtitle]}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <Border Margin="0,0,0,12" Padding="10,8" CornerRadius="6"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                        Visibility="{Binding HasConfigError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource Body}" Foreground="{DynamicResource DangerBrush}"
                               Text="{Binding ConfigErrorText}" />
                </Border>

                <TextBlock Style="{StaticResource SectionTitle}" Margin="0,0,0,6"
                           Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AiRequestSummary]}" />
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource Detail}" Margin="0,0,0,4"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AiProviderLabel]}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource MonoText}" Margin="0,0,0,4"
                                   Text="{Binding ProviderText}" TextTrimming="CharacterEllipsis" />

                        <TextBlock Grid.Row="1" Style="{StaticResource Detail}" Margin="0,0,0,4"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AiEndpointLabel]}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource MonoText}" Margin="0,0,0,4"
                                   Text="{Binding EndpointText}" TextTrimming="CharacterEllipsis" />

                        <TextBlock Grid.Row="2" Style="{StaticResource Detail}" Margin="0,0,0,4"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AiTokensLabel]}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource MonoText}" Margin="0,0,0,4"
                                   Text="{Binding TokenText}" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="3" Style="{StaticResource Detail}" Margin="0,0,0,4"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AiCostLabel]}" />
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Style="{StaticResource MonoText}" Text="{Binding CostText}" TextWrapping="Wrap" />
                            <Border Margin="8,0,0,0" Padding="5,1" CornerRadius="3" VerticalAlignment="Center"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    Visibility="{Binding HasCostSource, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource Detail}" Text="{Binding CostSourceText}" />
                            </Border>
                        </StackPanel>

                        <TextBlock Grid.Row="4" Style="{StaticResource Detail}" Margin="0,0,0,4"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AiBudgetLabel]}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource MonoText}" Margin="0,0,0,4"
                                   Text="{Binding BudgetText}" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="5" Style="{StaticResource Detail}" Margin="0,0,0,4"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AiRedactionLabel]}" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource MonoText}" Margin="0,0,0,4"
                                   Text="{Binding RedactionText}" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="6" Style="{StaticResource Detail}"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AiKeyLabel]}" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource MonoText}"
                                   Text="{Binding KeyText}" TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <Border Margin="0,0,0,12" Padding="10,8" CornerRadius="6"
                        Background="{DynamicResource AccentSoftBrush}"
                        Visibility="{Binding ConsentRequired, Converter={StaticResource BoolToVisibility}}">
                    <CheckBox IsChecked="{Binding ConsentChecked, Mode=TwoWay}">
                        <TextBlock Text="{Binding ConsentText}" TextWrapping="Wrap" />
                    </CheckBox>
                </Border>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource SectionTitle}" VerticalAlignment="Center"
                               Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AiPreviewTitle]}" />
                    <Button x:Name="CopyButton" Grid.Column="1" Style="{StaticResource FlatButton}" Padding="8,2"
                            Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AiCopy]}"
                            Click="OnCopyPreview" />
                </Grid>
                <TextBlock Style="{StaticResource Detail}" Margin="0,0,0,6"
                           Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AiPreviewHint]}" />
                <TextBox Style="{StaticResource PreviewBox}" Height="150" Margin="0,0,0,12"
                         Text="{Binding PreviewJson, Mode=OneWay}" />

                <Border Margin="0,0,0,12" Padding="10,8" CornerRadius="6"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Body}" Text="{Binding StatusText}" />
                        <TextBlock Style="{StaticResource Detail}" Margin="0,2,0,0" Text="{Binding ProgressText}" />
                    </StackPanel>
                </Border>

                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{Binding NoDataText}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasData}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                    <Border Margin="0,0,0,12" Padding="10,8" CornerRadius="6"
                            Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource WarnBrush}" BorderThickness="1"
                            Visibility="{Binding UsedLocalFallback, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold"
                                       Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AiLocalFallback]}" />
                            <TextBlock Style="{StaticResource Detail}" Margin="0,2,0,0" Text="{Binding FallbackText}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Margin="0,0,0,6"
                               Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AiSummary]}" />
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Body}" Text="{Binding SummaryText}" />
                            <TextBlock Style="{StaticResource Detail}" Margin="0,8,0,0" Text="{Binding CauseText}" />
                        </StackPanel>
                    </Border>

                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Evidence.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Style="{StaticResource SectionTitle}" Margin="0,0,0,6"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AiEvidence]}" />
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <ItemsControl ItemsSource="{Binding Evidence}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource MonoText}" Text="{Binding Metric}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource MonoText}" Text="{Binding Value}" />
                                            <TextBlock Grid.Column="2" Style="{StaticResource Detail}" Text="{Binding Interpretation}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>

                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Suspects.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Style="{StaticResource SectionTitle}" Margin="0,0,0,6"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AiSuspects]}" />
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <ItemsControl ItemsSource="{Binding Suspects}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Name}" />
                                                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="3"
                                                        Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock FontSize="9" Foreground="{DynamicResource AccentBrush}"
                                                               Text="{Binding Role}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource Detail}" Margin="0,2,0,0"
                                                       Text="{Binding Reason}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>

                    <StackPanel Visibility="{Binding HasFrameAnalysis, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource SectionTitle}" Margin="0,0,0,6"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AiFrames]}" />
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource Body}" Text="{Binding FrameText}" />
                        </Border>
                    </StackPanel>

                    <StackPanel Visibility="{Binding HasDropAnalysis, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource SectionTitle}" Margin="0,0,0,6"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AiDropsSection]}" />
                        <ItemsControl ItemsSource="{Binding DropRows}" Margin="0,0,0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding TimeText}" />
                                                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="3"
                                                        Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock FontSize="9" Foreground="{DynamicResource AccentBrush}"
                                                               Text="{Binding CauseText}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource Detail}" Margin="0,4,0,0"
                                                       Text="{Binding DetailText}" />
                                            <TextBlock Style="{StaticResource Detail}" Margin="0,2,0,0"
                                                       Text="{Binding SuspectText}"
                                                       Visibility="{Binding HasSuspect, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Visibility="{Binding HasHighLoadAttribution, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource SectionTitle}" Margin="0,0,0,6"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AiHighLoadSection]}" />
                        <ItemsControl ItemsSource="{Binding HighLoadRows}" Margin="0,0,0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding ResourceText}" />
                                                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="3"
                                                        Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock FontSize="9" Foreground="{DynamicResource AccentBrush}"
                                                               Text="{Binding ProcessText}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource Detail}" Margin="0,4,0,0"
                                                       Text="{Binding DetailText}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Recommendations.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Style="{StaticResource SectionTitle}" Margin="0,0,0,6"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AiRecommendations]}" />
                        <ItemsControl ItemsSource="{Binding Recommendations}" Margin="0,0,0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                                                           Text="{Binding Action}" MaxWidth="560" />
                                                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="3"
                                                        Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock FontSize="9" Text="{Binding Risk}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource Detail}" Margin="0,4,0,0"
                                                       Text="{Binding ExpectedText}" />
                                            <TextBlock Style="{StaticResource Detail}" Margin="0,2,0,0"
                                                       Text="{Binding HowText}" />
                                            <TextBlock Style="{StaticResource Detail}" Margin="0,2,0,0"
                                                       Text="{Binding RollbackText}"
                                                       Visibility="{Binding HasRollback, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource SectionTitle}" Margin="0,0,0,6"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AiWarnings]}" />
                        <TextBlock Style="{StaticResource Detail}" Margin="0,0,0,12" Text="{Binding WarningsText}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding HasLimitations, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource SectionTitle}" Margin="0,0,0,6"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AiLimitations]}" />
                        <TextBlock Style="{StaticResource Detail}" Margin="0,0,0,12" Text="{Binding LimitationsText}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource Detail}" Margin="0,0,0,6" Text="{Binding DisclaimerText}"
                               Visibility="{Binding HasDisclaimer, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Style="{StaticResource MonoText}" Margin="0,0,0,6" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding SavedText}"
                               Visibility="{Binding HasSavedPath, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Style="{StaticResource FlatButton}" HorizontalAlignment="Left"
                    Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AiOpenReports]}"
                    Click="OnOpenReports" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource FlatButton}" Margin="0,0,8,0"
                        Content="{Binding RunText}"
                        IsEnabled="{Binding CanRun}"
                        Click="OnRunClick" />
                <Button Style="{StaticResource FlatButton}" Margin="0,0,8,0"
                        Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AiCancel]}"
                        IsEnabled="{Binding IsRunning}"
                        Click="OnCancelClick" />
                <Button Style="{StaticResource FlatButton}"
                        Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AiClose]}"
                        Click="OnCloseClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
