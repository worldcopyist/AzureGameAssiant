<Window x:Class="AzureGameAssistant.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:AzureGameAssistant.UI.Services"
        Title="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[SettingsTitle]}"
        Icon="pack://application:,,,/Assets/app-icon.ico"
        Width="580" Height="780" MinWidth="540" MinHeight="560"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Margin="0,0,0,8"
                           Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[SamplingSection]}" />
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[NormalInterval]}" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding IntervalOptions}"
                                  SelectedItem="{Binding NormalMs, Mode=TwoWay}" />

                        <TextBlock Grid.Row="1" Margin="0,10,0,0" VerticalAlignment="Center"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[GameInterval]}" />
                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" ItemsSource="{Binding IntervalOptions}"
                                  SelectedItem="{Binding GameMs, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <TextBlock Style="{StaticResource SectionTitle}" Margin="0,0,0,8"
                           Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[DetectionSection]}" />
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding DetectionEnabled, Mode=TwoWay}"
                                  Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[DetectionEnabled]}" />
                        <TextBlock Margin="24,2,0,10" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[DetectionHint]}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" MinWidth="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock VerticalAlignment="Center"
                                       Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[DetectionFrameSpikeRatio]}" />
                            <TextBox Grid.Column="1" Width="80" HorizontalAlignment="Left"
                                     Text="{Binding DetectionFrameSpikeRatio, Mode=TwoWay}" />

                            <TextBlock Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center"
                                       Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[DetectionFrameSpikeFloor]}" />
                            <TextBox Grid.Column="3" Width="80" HorizontalAlignment="Left"
                                     Text="{Binding DetectionFrameSpikeFloorMs, Mode=TwoWay}" />

                            <TextBlock Grid.Row="1" Margin="0,8,0,0" VerticalAlignment="Center"
                                       Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[DetectionDisplayGap]}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Width="80" Margin="0,8,0,0" HorizontalAlignment="Left"
                                     Text="{Binding DetectionDisplayGapMs, Mode=TwoWay}" />

                            <TextBlock Grid.Row="1" Grid.Column="2" Margin="16,8,0,0" VerticalAlignment="Center"
                                       Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[DetectionJitterConfirm]}" />
                            <TextBox Grid.Row="1" Grid.Column="3" Width="80" Margin="0,8,0,0" HorizontalAlignment="Left"
                                     Text="{Binding DetectionJitterConfirmMs, Mode=TwoWay}" />

                            <TextBlock Grid.Row="2" Margin="0,8,0,0" VerticalAlignment="Center"
                                       Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[DetectionJitterSuspect]}" />
                            <TextBox Grid.Row="2" Grid.Column="1" Width="80" Margin="0,8,0,0" HorizontalAlignment="Left"
                                     Text="{Binding DetectionJitterSuspectMs, Mode=TwoWay}" />

                            <TextBlock Grid.Row="2" Grid.Column="2" Margin="16,8,0,0" VerticalAlignment="Center"
                                       Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[DetectionConfirmScore]}" />
                            <TextBox Grid.Row="2" Grid.Column="3" Width="80" Margin="0,8,0,0" HorizontalAlignment="Left"
                                     Text="{Binding DetectionConfirmScore, Mode=TwoWay}" />

                            <TextBlock Grid.Row="3" Margin="0,8,0,0" VerticalAlignment="Center"
                                       Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[DetectionCpuRatio]}" />
                            <TextBox Grid.Row="3" Grid.Column="1" Width="80" Margin="0,8,0,0" HorizontalAlignment="Left"
                                     Text="{Binding DetectionCpuSpikeRatio, Mode=TwoWay}" />

                            <TextBlock Grid.Row="3" Grid.Column="2" Margin="16,8,0,0" VerticalAlignment="Center"
                                       Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[DetectionGpuPct]}" />
                            <TextBox Grid.Row="3" Grid.Column="3" Width="80" Margin="0,8,0,0" HorizontalAlignment="Left"
                                     Text="{Binding DetectionGpuSpikePct, Mode=TwoWay}" />

                            <TextBlock Grid.Row="4" Margin="0,8,0,0" VerticalAlignment="Center"
                                       Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[DetectionMemFloor]}" />
                            <TextBox Grid.Row="4" Grid.Column="1" Width="80" Margin="0,8,0,0" HorizontalAlignment="Left"
                                     Text="{Binding DetectionMemFloorMb, Mode=TwoWay}" />

                            <TextBlock Grid.Row="4" Grid.Column="2" Margin="16,8,0,0" VerticalAlignment="Center"
                                       Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[DetectionCommit]}" />
                            <TextBox Grid.Row="4" Grid.Column="3" Width="80" Margin="0,8,0,0" HorizontalAlignment="Left"
                                     Text="{Binding DetectionCommitRatio, Mode=TwoWay}" />

                            <TextBlock Grid.Row="5" Margin="0,8,0,0" VerticalAlignment="Center"
                                       Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[DetectionDiskLatency]}" />
                            <TextBox Grid.Row="5" Grid.Column="1" Width="80" Margin="0,8,0,0" HorizontalAlignment="Left"
                                     Text="{Binding DetectionDiskLatencyMs, Mode=TwoWay}" />

                            <TextBlock Grid.Row="6" Margin="0,8,0,0" VerticalAlignment="Center"
                                       Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[DetectionQuiet]}" />
                            <TextBox Grid.Row="6" Grid.Column="1" Width="80" Margin="0,8,0,0" HorizontalAlignment="Left"
                                     Text="{Binding DetectionQuietMs, Mode=TwoWay}" />

                            <TextBlock Grid.Row="6" Grid.Column="2" Margin="16,8,0,0" VerticalAlignment="Center"
                                       Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[DetectionCooldown]}" />
                            <TextBox Grid.Row="6" Grid.Column="3" Width="80" Margin="0,8,0,0" HorizontalAlignment="Left"
                                     Text="{Binding DetectionCooldownMs, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource SectionTitle}" Margin="0,0,0,8"
                           Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[ChartsSection]}" />
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <WrapPanel>
                        <CheckBox Margin="0,0,24,8" IsChecked="{Binding ChartSeparate, Mode=TwoWay}"
                                  Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[ChartSeparateToggle]}"
                                  ToolTip="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[ChartSeparateHint]}" />
                        <CheckBox Margin="0,0,24,8" IsChecked="{Binding ChartFrames, Mode=TwoWay}"
                                  Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[ChartFrameToggle]}" />
                        <CheckBox Margin="0,0,24,8" IsChecked="{Binding ChartCpu, Mode=TwoWay}"
                                  Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[ChartCpuToggle]}" />
                        <CheckBox Margin="0,0,24,8" IsChecked="{Binding ChartGpu, Mode=TwoWay}"
                                  Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[ChartGpuToggle]}" />
                        <CheckBox Margin="0,0,24,8" IsChecked="{Binding ChartMemory, Mode=TwoWay}"
                                  Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[ChartMemoryToggle]}" />
                        <CheckBox Margin="0,0,24,8" IsChecked="{Binding ChartVram, Mode=TwoWay}"
                                  Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[ChartVramToggle]}" />
                        <CheckBox Margin="0,0,24,8" IsChecked="{Binding ChartDisk, Mode=TwoWay}"
                                  Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[ChartDiskToggle]}" />
                    </WrapPanel>
                </Border>

                <TextBlock Style="{StaticResource SectionTitle}" Margin="0,0,0,8"
                           Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[InterfaceSection]}" />
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[ThemeLabel]}" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding ThemeOptions}" DisplayMemberPath="Display"
                                  SelectedValuePath="Value" SelectedValue="{Binding Theme, Mode=TwoWay}" />

                        <TextBlock Grid.Row="1" Margin="0,10,0,0" VerticalAlignment="Center"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[LanguageLabel]}" />
                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,10,0,0"
                                  ItemsSource="{Binding LanguageOptions}" DisplayMemberPath="Display"
                                  SelectedValuePath="Value" SelectedValue="{Binding Language, Mode=TwoWay}" />

                        <CheckBox Grid.Row="2" Grid.ColumnSpan="2" Margin="0,14,0,0"
                                  IsChecked="{Binding Notifications, Mode=TwoWay}"
                                  Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[NotificationsLabel]}" />

                        <CheckBox Grid.Row="3" Grid.ColumnSpan="2" Margin="0,8,0,0"
                                  IsChecked="{Binding AutoStart, Mode=TwoWay}"
                                  Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AutoStartLabel]}" />

                        <TextBlock Grid.Row="4" Margin="0,12,0,0" VerticalAlignment="Center"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[HotkeyLabel]}" />
                        <TextBox Grid.Row="4" Grid.Column="1" Margin="0,12,0,0" MinWidth="160"
                                 Text="{Binding Hotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Margin="24,2,0,0" FontSize="11"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[HotkeyHint]}" />
                    </Grid>
                </Border>

                <TextBlock Style="{StaticResource SectionTitle}" Margin="0,0,0,8"
                           Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[PermissionsSection]}" />
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding RequestElevationOnStartup, Mode=TwoWay}"
                                  Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[RequestElevationLabel]}" />
                        <TextBlock Margin="24,2,0,10" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[RequestElevationHint]}" />

                        <CheckBox IsChecked="{Binding AutoCapture, Mode=TwoWay}"
                                  Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AutoCaptureLabel]}" />
                        <TextBlock Margin="24,2,0,10" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AutoCaptureHint]}" />

                        <TextBlock Style="{StaticResource SectionTitle}" Margin="0,4,0,8"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[CpuTemperatureSection]}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[CpuTemperatureModeLabel]}" />
                            <ComboBox Grid.Column="1" MinWidth="220" ItemsSource="{Binding CpuModeOptions}"
                                      DisplayMemberPath="Display" SelectedValuePath="Value"
                                      SelectedValue="{Binding CpuMode, Mode=TwoWay}" />
                        </Grid>
                        <TextBlock Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[CpuTempModeHint]}" />
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource SectionTitle}" Margin="0,0,0,8"
                           Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AiSection]}" />
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding AiEnabled, Mode=TwoWay}"
                                  Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AiEnableLabel]}" />
                        <TextBlock Margin="24,2,0,10" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AiEnableHint]}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock VerticalAlignment="Center"
                                       Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AiProviderLabel]}" />
                            <ComboBox Grid.Column="1" MinWidth="220" ItemsSource="{Binding AiProviderOptions}"
                                      DisplayMemberPath="Display" SelectedValuePath="Value"
                                      SelectedValue="{Binding AiActiveProvider, Mode=TwoWay}" />

                            <TextBlock Grid.Row="1" Margin="0,10,0,0" VerticalAlignment="Center"
                                       Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AiBaseUrlLabel]}" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" Orientation="Horizontal">
                                <TextBox Width="200"
                                         Text="{Binding AiBaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Style="{StaticResource FlatButton}" Padding="8,2" Margin="6,0,0,0"
                                        Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AiTestConnection]}"
                                        ToolTip="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AiTestHint]}"
                                        IsEnabled="{Binding CanTestAiConnection}"
                                        Click="OnTestAiConnection" />
                            </StackPanel>

                            <TextBlock Grid.Row="2" Margin="0,10,0,0" VerticalAlignment="Center"
                                       Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AiModelLabel]}" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,10,0,0" Orientation="Horizontal">
                                <TextBox Width="150"
                                         Text="{Binding AiModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <ComboBox Width="130" Margin="6,0,0,0"
                                          ItemsSource="{Binding AiModelOptions}"
                                          Visibility="{Binding HasAiModelOptions, Converter={StaticResource BoolToVisibility}}"
                                          ToolTip="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AiModelsPickHint]}"
                                          SelectionChanged="OnAiModelPicked" />
                                <Button Style="{StaticResource FlatButton}" Padding="8,2" Margin="6,0,0,0"
                                        Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AiModelsFetch]}"
                                        ToolTip="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AiModelsHint]}"
                                        IsEnabled="{Binding CanFetchAiModels}"
                                        Click="OnFetchAiModels" />
                            </StackPanel>

                            <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{Binding AiTestStatus}" />

                            <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{Binding AiModelsStatus}" />

                            <TextBlock Grid.Row="5" Margin="0,10,0,0" VerticalAlignment="Center"
                                       Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AiApiKeyLabel]}" />
                            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                                <PasswordBox x:Name="AiKeyBox" Width="176" IsEnabled="{Binding AiKeyInputEnabled}" />
                                <Button Style="{StaticResource FlatButton}" Padding="8,2" Margin="6,0,0,0"
                                        Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AiKeySave]}"
                                        Click="OnSaveAiKey" />
                                <Button Style="{StaticResource FlatButton}" Padding="8,2" Margin="6,0,0,0"
                                        Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AiKeyDelete]}"
                                        Click="OnDeleteAiKey" />
                            </StackPanel>

                            <TextBlock Grid.Row="6" Grid.Column="1" Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{Binding AiKeyStatus}" />
                        </Grid>

                        <CheckBox Margin="0,12,0,0" IsChecked="{Binding AiRedact, Mode=TwoWay}"
                                  Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AiRedactLabel]}" />
                        <CheckBox Margin="0,8,0,0" IsChecked="{Binding AiHideProcessNames, Mode=TwoWay}"
                                  Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AiHideProcessLabel]}" />

                        <TextBlock Style="{StaticResource SectionTitle}" Margin="0,16,0,8"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AiBudgetSection]}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock VerticalAlignment="Center"
                                       Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AiInputPriceLabel]}" />
                            <TextBox Grid.Column="1" Width="90"
                                     Text="{Binding AiInputPricePerMillion, Mode=TwoWay}" />

                            <TextBlock Grid.Row="1" Margin="0,10,0,0" VerticalAlignment="Center"
                                       Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AiOutputPriceLabel]}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Width="90" Margin="0,10,0,0"
                                     Text="{Binding AiOutputPricePerMillion, Mode=TwoWay}" />

                            <TextBlock Grid.Row="2" Margin="0,10,0,0" VerticalAlignment="Center"
                                       Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AiDailyBudgetLabel]}" />
                            <TextBox Grid.Row="2" Grid.Column="1" Width="90" Margin="0,10,0,0"
                                     Text="{Binding AiDailyBudget, Mode=TwoWay}" />

                            <TextBlock Grid.Row="3" Margin="0,10,0,0" VerticalAlignment="Center"
                                       Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AiMonthlyBudgetLabel]}" />
                            <TextBox Grid.Row="3" Grid.Column="1" Width="90" Margin="0,10,0,0"
                                     Text="{Binding AiMonthlyBudget, Mode=TwoWay}" />
                        </Grid>
                        <TextBlock Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AiBudgetHint]}" />
                        <TextBlock Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AiConsentHint]}" />
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource SectionTitle}" Margin="0,0,0,8"
                           Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[OverlaySection]}" />
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding OverlayEnabled, Mode=TwoWay}"
                                  Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[OverlayEnabled]}" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock VerticalAlignment="Center"
                                       Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[OverlayPosition]}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding OverlayCornerOptions}"
                                      DisplayMemberPath="Display" SelectedValuePath="Value"
                                      SelectedValue="{Binding OverlayCorner, Mode=TwoWay}" />

                            <TextBlock Grid.Row="1" Margin="0,10,0,0" VerticalAlignment="Center"
                                       Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[OverlayOffsetX]}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Width="76" Margin="0,10,0,0"
                                     Text="{Binding OverlayOffsetX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="2" Margin="0,10,0,0" VerticalAlignment="Center"
                                       Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[OverlayOffsetY]}" />
                            <TextBox Grid.Row="2" Grid.Column="1" Width="76" Margin="0,10,0,0"
                                     Text="{Binding OverlayOffsetY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <TextBlock Style="{StaticResource SectionTitle}" Margin="0,16,0,8"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[OverlayAppearance]}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock VerticalAlignment="Center"
                                       Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[OverlayTheme]}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding OverlayThemeOptions}"
                                      DisplayMemberPath="Display" SelectedValuePath="Value"
                                      SelectedValue="{Binding OverlayTheme, Mode=TwoWay}" />

                            <TextBlock Grid.Row="1" Margin="0,10,0,0" VerticalAlignment="Center"
                                       Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[OverlayColor]}" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBox Width="92" IsEnabled="{Binding IsOverlayCustomTheme}"
                                         ToolTip="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[OverlayColorHint]}"
                                         Text="{Binding OverlayColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Border Width="24" Height="24" Margin="6,0,0,0" CornerRadius="3"
                                        BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                                        Background="{Binding OverlayColorPreview}" />
                            </StackPanel>

                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Margin="0,4,0,0" FontSize="11"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[OverlayColorHint]}" />
                        </Grid>

                        <TextBlock Style="{StaticResource SectionTitle}" Margin="0,16,0,8"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[OverlayContent]}" />
                        <WrapPanel>
                            <CheckBox Margin="0,0,24,8" IsChecked="{Binding OverlayFps, Mode=TwoWay}"
                                      Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[OverlayFps]}" />
                            <CheckBox Margin="0,0,24,8" IsChecked="{Binding OverlayFrameTimes, Mode=TwoWay}"
                                      Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[OverlayFrameTimes]}" />
                            <CheckBox Margin="0,0,24,8" IsChecked="{Binding OverlayCpu, Mode=TwoWay}"
                                      Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[Cpu]}" />
                            <CheckBox Margin="0,0,24,8" IsChecked="{Binding OverlayGpu, Mode=TwoWay}"
                                      Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[Gpu]}" />
                            <CheckBox Margin="0,0,24,8" IsChecked="{Binding OverlayTemperature, Mode=TwoWay}"
                                      Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[OverlayTemperature]}" />
                            <CheckBox Margin="0,0,24,8" IsChecked="{Binding OverlayCpuTemperature, Mode=TwoWay}"
                                      Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[OverlayCpuTemperature]}" />
                            <CheckBox Margin="0,0,24,8" IsChecked="{Binding OverlayMemory, Mode=TwoWay}"
                                      Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[Memory]}" />
                            <CheckBox Margin="0,0,24,8" IsChecked="{Binding OverlayVram, Mode=TwoWay}"
                                      Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[Vram]}" />
                        </WrapPanel>

                        <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[OverlayNotice]}" />
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource SectionTitle}" Margin="0,0,0,8"
                           Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[DiagnosticsSection]}" />
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding LongRunRecord, Mode=TwoWay}"
                                  Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[LongRunRecordLabel]}" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[LongRunIntervalLabel]}" />
                            <ComboBox Grid.Column="1" MinWidth="90" ItemsSource="{Binding LongRunIntervalOptions}"
                                      SelectedItem="{Binding LongRunIntervalSeconds, Mode=TwoWay}" />
                        </Grid>
                        <TextBlock Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[LongRunHint]}" />
                        <Button Style="{StaticResource FlatButton}" Padding="8,2" Margin="0,10,0,0"
                                HorizontalAlignment="Left"
                                Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[OpenDiagnosticsFolder]}"
                                Click="OnOpenDiagnosticsFolder" />
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource SectionTitle}" Margin="0,0,0,8"
                           Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[LogsSection]}" />
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding LogRecording, Mode=TwoWay}"
                                  Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[LogRecordingLabel]}" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[LogRetentionLabel]}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ComboBox MinWidth="80" ItemsSource="{Binding LogRetentionOptions}"
                                          SelectedItem="{Binding LogRetentionDays, Mode=TwoWay}" />
                                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
                                           Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[LogRetentionUnit]}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[LogRecordingHint]}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource FlatButton}" Padding="8,2"
                                    Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[Open]}"
                                    Click="OnOpenLogs" />
                            <Button Style="{StaticResource FlatButton}" Padding="8,2" Margin="8,0,0,0"
                                    Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[OpenIssueLogs]}"
                                    Click="OnOpenIssueLogs" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource SectionTitle}" Margin="0,0,0,8"
                           Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[SessionSettingsTitle]}" />
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[SessionMaxCount]}" />
                        <TextBox Grid.Column="1" Width="80" HorizontalAlignment="Left"
                                 Text="{Binding SessionMaxCount, Mode=TwoWay}" />
                        <TextBlock Grid.Row="1" Margin="0,10,0,0" VerticalAlignment="Center"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[SessionMaxTotalMb]}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Width="80" Margin="0,10,0,0" HorizontalAlignment="Left"
                                 Text="{Binding SessionMaxTotalMb, Mode=TwoWay}" />
                        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[SessionRetentionHint]}" />
                    </Grid>
                </Border>

                <TextBlock Style="{StaticResource SectionTitle}" Margin="0,0,0,8"
                           Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AboutSection]}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="72" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                       Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[VersionLabel]}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource MonoText}" Text="{Binding AppVersion}" />
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="72" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                       Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[LogsLabel]}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource MonoText}" Text="{Binding LogsPath}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding LogsPath}" />
                            <Button Grid.Column="2" Style="{StaticResource FlatButton}" Padding="8,2" Margin="8,0,0,0"
                                    Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[Open]}"
                                    Click="OnOpenLogs" />
                        </Grid>

                        <TextBlock Style="{StaticResource MonoText}" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding DataPath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DataPath}" />

                        <TextBlock Margin="0,12,0,0" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[M1Notice]}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock VerticalAlignment="Center" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[NeedsRestart]}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource FlatButton}" Margin="0,0,8,0" Click="OnCancel"
                        Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[Cancel]}" />
                <Button Style="{StaticResource FlatButton}" Click="OnApply"
                        Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[Apply]}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
