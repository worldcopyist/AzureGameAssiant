<Window x:Class="AzureGameAssistant.UI.ChartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560" Height="300" MinWidth="360" MinHeight="200"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Icon="pack://application:,,,/Assets/app-icon.ico"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Border Style="{StaticResource Card}" Margin="12" Padding="8">
        <ContentControl x:Name="Host" />
    </Border>
</Window>
