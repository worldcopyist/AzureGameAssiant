<Window x:Class="AzureGameAssistant.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:AzureGameAssistant.UI.Services"
        xmlns:controls="clr-namespace:AzureGameAssistant.UI.Controls"
        Title="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AppTitle]}"
        Icon="pack://application:,,,/Assets/app-icon.ico"
        Width="1080" Height="720" MinWidth="880" MinHeight="600"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="ChartCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="4" />
        </Style>
    </Window.Resources>

    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Focusable="False" PanningMode="VerticalOnly">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="ChartRow" Height="280" MinHeight="240" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Style="{StaticResource HeaderTitle}"
                           Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AppTitle]}" />
                <TextBlock Margin="0,2,0,0" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AppSubtitle]}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border CornerRadius="11" Padding="10,4" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource WarnBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnectedToCollector}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource OkBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasCollectorProblem}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock FontSize="12" Text="{Binding CollectorStatusText}" />
                    </StackPanel>
                </Border>

                <Button Style="{StaticResource FlatButton}" Margin="0,0,8,0"
                        AutomationProperties.AutomationId="AiAnalyzeButton"
                        Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AiAnalyzeButton]}"
                        Click="OnAiAnalyzeClick" />
                <Button Style="{StaticResource FlatButton}" Margin="0,0,8,0"
                        AutomationProperties.AutomationId="PauseButton"
                        Content="{Binding PauseText}"
                        Command="{Binding TogglePauseCommand}" />
                <Button Style="{StaticResource FlatButton}"
                        AutomationProperties.AutomationId="SettingsButton"
                        Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[Settings]}"
                        Click="OnSettingsClick" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardLabel}"
                               Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[Cpu]}" />
                    <TextBlock Style="{StaticResource CardValue}" Text="{Binding CpuValue}" />
                    <TextBlock Style="{StaticResource CardSub}" Text="{Binding CpuSub}" />
                    <TextBlock Margin="0,3,0,0" FontSize="10" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding CpuName}" ToolTip="{Binding CpuName}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardLabel}"
                               Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[Gpu]}" />
                    <TextBlock Style="{StaticResource CardValue}" Text="{Binding GpuValue}" />
                    <TextBlock Style="{StaticResource CardSub}" Text="{Binding GpuSub}" />
                    <TextBlock Margin="0,3,0,0" FontSize="10" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding GpuName}" ToolTip="{Binding GpuName}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardLabel}"
                               Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[Memory]}" />
                    <TextBlock Style="{StaticResource CardValue}" Text="{Binding MemoryValue}" />
                    <TextBlock Style="{StaticResource CardSub}" Text="{Binding MemorySub}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Style="{StaticResource Card}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardLabel}"
                               Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[Vram]}" />
                    <TextBlock Style="{StaticResource CardValue}" Text="{Binding VramValue}" />
                    <TextBlock Style="{StaticResource CardSub}" Text="{Binding VramSub}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource Card}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardLabel}"
                               Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[Disk]}" />
                    <TextBlock Style="{StaticResource CardValue}" Text="{Binding DiskValue}" />
                    <TextBlock Style="{StaticResource CardSub}" Text="{Binding DiskSub}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="5" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardLabel}"
                               Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[Jitter]}" />
                    <TextBlock Style="{StaticResource CardValue}" Text="{Binding JitterValue}" />
                    <TextBlock Style="{StaticResource CardSub}" Text="{Binding JitterSub}" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="14,10,14,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold"
                               Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[LiveTimeline]}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <CheckBox x:Name="DesignToggle" VerticalAlignment="Center" Margin="0,0,12,0"
                                  Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[ChartDesignMode]}"
                                  ToolTip="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[ChartDesignHint]}"
                                  Visibility="{Binding ShowSeparateCharts, Converter={StaticResource BoolToVisibility}}"
                                  Checked="OnDesignModeChanged" Unchecked="OnDesignModeChanged" />
                        <ComboBox x:Name="WindowSelector" MinWidth="100">
                            <ComboBoxItem Tag="60"
                                          Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[WindowOneMinute]}" />
                            <ComboBoxItem Tag="300"
                                          Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[WindowFiveMinutes]}" />
                            <ComboBoxItem Tag="900"
                                          Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[WindowFifteenMinutes]}" />
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <Border x:Name="CombinedCard" Grid.Row="1" Style="{StaticResource ChartCard}" Margin="14,0,14,10"
                        Visibility="{Binding ShowCombinedChart, Converter={StaticResource BoolToVisibility}}">
                    <controls:TimelineChart x:Name="CombinedChart" Metric="Combined" MinHeight="120" />
                </Border>

                <ScrollViewer x:Name="ChartScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="10,0,10,10"
                              Visibility="{Binding ShowSeparateCharts, Converter={StaticResource BoolToVisibility}}">
                    <UniformGrid x:Name="ChartGrid" Columns="2">
                        <Border Style="{StaticResource ChartCard}"
                                Visibility="{Binding ShowFrameChart, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Margin="4,0,4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardLabel}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ChartFrameBrush}"
                                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[FrameChartLabel]}" />
                                        <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="{Binding FrameSub}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Margin="0,0,6,0" Style="{StaticResource MonoText}"
                                               Text="{Binding FrameValue}" />
                                    <Button Grid.Column="2" Style="{StaticResource FlatButton}" Padding="6,0" FontSize="10"
                                            Visibility="{Binding IsChecked, ElementName=DesignToggle, Converter={StaticResource BoolToVisibility}}"
                                            Content="↗" Tag="Frame" Click="OnDetachChart"
                                            ToolTip="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[ChartDetach]}" />
                                </Grid>
                                <controls:TimelineChart Grid.Row="1" x:Name="FrameChart" Metric="Frame" MinHeight="170" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource ChartCard}"
                                Visibility="{Binding ShowCpuChart, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Margin="4,0,4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource CardLabel}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ChartCpuBrush}"
                                               Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[Cpu]}" />
                                    <TextBlock Grid.Column="1" Margin="0,0,6,0" Style="{StaticResource MonoText}"
                                               Text="{Binding CpuValue}" />
                                    <Button Grid.Column="2" Style="{StaticResource FlatButton}" Padding="6,0" FontSize="10"
                                            Visibility="{Binding IsChecked, ElementName=DesignToggle, Converter={StaticResource BoolToVisibility}}"
                                            Content="↗" Tag="Cpu" Click="OnDetachChart"
                                            ToolTip="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[ChartDetach]}" />
                                </Grid>
                                <controls:TimelineChart Grid.Row="1" x:Name="CpuChart" Metric="Cpu" MinHeight="170" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource ChartCard}"
                                Visibility="{Binding ShowGpuChart, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Margin="4,0,4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource CardLabel}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ChartGpuBrush}"
                                               Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[Gpu]}" />
                                    <TextBlock Grid.Column="1" Margin="0,0,6,0" Style="{StaticResource MonoText}"
                                               Text="{Binding GpuValue}" />
                                    <Button Grid.Column="2" Style="{StaticResource FlatButton}" Padding="6,0" FontSize="10"
                                            Visibility="{Binding IsChecked, ElementName=DesignToggle, Converter={StaticResource BoolToVisibility}}"
                                            Content="↗" Tag="Gpu" Click="OnDetachChart"
                                            ToolTip="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[ChartDetach]}" />
                                </Grid>
                                <controls:TimelineChart Grid.Row="1" x:Name="GpuChart" Metric="Gpu" MinHeight="170" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource ChartCard}"
                                Visibility="{Binding ShowMemoryChart, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Margin="4,0,4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource CardLabel}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ChartMemBrush}"
                                               Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[Memory]}" />
                                    <TextBlock Grid.Column="1" Margin="0,0,6,0" Style="{StaticResource MonoText}"
                                               Text="{Binding MemoryValue}" />
                                    <Button Grid.Column="2" Style="{StaticResource FlatButton}" Padding="6,0" FontSize="10"
                                            Visibility="{Binding IsChecked, ElementName=DesignToggle, Converter={StaticResource BoolToVisibility}}"
                                            Content="↗" Tag="Memory" Click="OnDetachChart"
                                            ToolTip="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[ChartDetach]}" />
                                </Grid>
                                <controls:TimelineChart Grid.Row="1" x:Name="MemoryChart" Metric="Memory" MinHeight="170" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource ChartCard}"
                                Visibility="{Binding ShowVramChart, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Margin="4,0,4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource CardLabel}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ChartVramBrush}"
                                               Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[Vram]}" />
                                    <TextBlock Grid.Column="1" Margin="0,0,6,0" Style="{StaticResource MonoText}"
                                               Text="{Binding VramValue}" />
                                    <Button Grid.Column="2" Style="{StaticResource FlatButton}" Padding="6,0" FontSize="10"
                                            Visibility="{Binding IsChecked, ElementName=DesignToggle, Converter={StaticResource BoolToVisibility}}"
                                            Content="↗" Tag="Vram" Click="OnDetachChart"
                                            ToolTip="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[ChartDetach]}" />
                                </Grid>
                                <controls:TimelineChart Grid.Row="1" x:Name="VramChart" Metric="Vram" MinHeight="170" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource ChartCard}"
                                Visibility="{Binding ShowDiskChart, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Margin="4,0,4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource CardLabel}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ChartDiskBrush}"
                                               Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[Disk]}" />
                                    <TextBlock Grid.Column="1" Margin="0,0,6,0" Style="{StaticResource MonoText}"
                                               Text="{Binding DiskValue}" />
                                    <Button Grid.Column="2" Style="{StaticResource FlatButton}" Padding="6,0" FontSize="10"
                                            Visibility="{Binding IsChecked, ElementName=DesignToggle, Converter={StaticResource BoolToVisibility}}"
                                            Content="↗" Tag="Disk" Click="OnDetachChart"
                                            ToolTip="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[ChartDetach]}" />
                                </Grid>
                                <controls:TimelineChart Grid.Row="1" x:Name="DiskChart" Metric="Disk" MinHeight="170" />
                            </Grid>
                        </Border>
                    </UniformGrid>
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Margin="0,0,0,8"
                               Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[Processes]}" />

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="88" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[ColumnProcess]}" />
                        <TextBlock Grid.Column="1" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[ColumnPid]}" />
                        <TextBlock Grid.Column="2" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[ColumnCpu]}" />
                        <TextBlock Grid.Column="3" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[ColumnGpu]}" />
                        <TextBlock Grid.Column="4" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[ColumnMemory]}" />
                    </Grid>

                    <!-- The application's own footprint is always visible so the
                         resident cost stays accountable next to the top games. -->
                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="4" Margin="0,0,0,4"
                            ToolTip="{Binding SelfUsageDetail}">
                        <Grid Height="26">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="88" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Margin="6,0,0,0" FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Text="{Binding SelfUsageName}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource MonoText}" VerticalAlignment="Center"
                                       Text="{Binding SelfUsagePid}" />
                            <TextBlock Grid.Column="2" Style="{StaticResource MonoText}" VerticalAlignment="Center"
                                       Text="{Binding SelfUsageCpu}" />
                            <TextBlock Grid.Column="3" Style="{StaticResource MonoText}" VerticalAlignment="Center"
                                       Text="—" />
                            <TextBlock Grid.Column="4" Style="{StaticResource MonoText}" VerticalAlignment="Center"
                                       Text="{Binding SelfUsageMemory}" />
                        </Grid>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Processes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="27">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="88" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsForeground}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="3" Padding="4,1" Margin="6,0,0,0"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tag}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="9" Foreground="{DynamicResource AccentBrush}" Text="{Binding Tag}" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Style="{StaticResource MonoText}" VerticalAlignment="Center"
                                               Text="{Binding PidText}" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource MonoText}" VerticalAlignment="Center"
                                               Text="{Binding CpuText}" />
                                    <TextBlock Grid.Column="3" Style="{StaticResource MonoText}" VerticalAlignment="Center"
                                               Text="{Binding GpuText}" />
                                    <TextBlock Grid.Column="4" Style="{StaticResource MonoText}" VerticalAlignment="Center"
                                               Text="{Binding MemoryText}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Separator Margin="0,12,0,10" Background="{DynamicResource BorderBrush}" />

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SectionTitle}"
                                       Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[StutterTitle]}" />
                            <TextBlock FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{Binding StutterSummaryText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource FlatButton}" Padding="10,2" FontSize="11" Margin="0,0,6,0"
                                    Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[SessionsButton]}"
                                    ToolTip="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[SessionsHint]}"
                                    Click="OnSessionsClick" />
                            <Button Style="{StaticResource FlatButton}" Padding="10,2" FontSize="11"
                                    Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[MarkStutter]}"
                                    ToolTip="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[MarkStutterHint]}"
                                    Command="{Binding MarkStutterCommand}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="46" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[ColumnTime]}" />
                        <TextBlock Grid.Column="1" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[StutterScoreHeader]}" />
                        <TextBlock Grid.Column="2" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[StutterCauseHeader]}" />
                        <TextBlock Grid.Column="3" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[StutterSignalHeader]}" />
                        <TextBlock Grid.Column="5" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[StutterDurationHeader]}"
                                   HorizontalAlignment="Right" />
                    </Grid>

                    <ScrollViewer MaxHeight="156" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding StutterEvents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="58" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="46" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource MonoText}" VerticalAlignment="Center"
                                                   Text="{Binding TimeText}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource MonoText}" VerticalAlignment="Center"
                                                   Text="{Binding ScoreText}" />
                                        <TextBlock Grid.Column="2" FontSize="11" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Text="{Binding CauseText}" />
                                        <TextBlock Grid.Column="3" FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" Text="{Binding SignalsText}"
                                                   ToolTip="{Binding PeakText}" />
                                        <TextBlock Grid.Column="4" FontSize="11" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Text="{Binding ProcessName}" />
                                        <TextBlock Grid.Column="5" Style="{StaticResource MonoText}" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" Text="{Binding DurationText}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Margin="0,0,0,8"
                               Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[Status]}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="72" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[CollectorLabel]}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource MonoText}" TextTrimming="CharacterEllipsis"
                                   Text="{Binding CollectorDetailText}" Margin="0,0,0,4" />

                        <TextBlock Grid.Row="1" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[SamplingLabel]}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource MonoText}" Text="{Binding IntervalText}" Margin="0,0,0,4" />

                        <TextBlock Grid.Row="2" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[UptimeLabel]}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource MonoText}" Text="{Binding UptimeText}" Margin="0,0,0,4" />

                        <TextBlock Grid.Row="3" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[SamplesLabel]}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource MonoText}" Text="{Binding SampleCountText}" Margin="0,0,0,4" />

                        <TextBlock Grid.Row="4" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[HeartbeatLabel]}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource MonoText}" Text="{Binding HeartbeatText}" />

                        <TextBlock Grid.Row="5" Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                   Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[ModeLabel]}" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,4,0,0" Style="{StaticResource MonoText}"
                                   Text="{Binding ModeText}"
                                   ToolTip="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[ModeHint]}" />
                    </Grid>

                    <Separator Margin="0,12,0,10" Background="{DynamicResource BorderBrush}" />

                    <TextBlock FontSize="12" FontWeight="SemiBold"
                               Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[FrameCaptureLabel]}" />
                    <ComboBox Margin="0,6,0,6" MinWidth="180" DisplayMemberPath="Display"
                              ItemsSource="{Binding FrameTargets}"
                              SelectedItem="{Binding SelectedFrameTarget}"
                              DropDownOpened="OnFrameTargetDropDownOpened"
                              ToolTip="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[FrameTargetPlaceholder]}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Style="{StaticResource FlatButton}" Padding="10,2" FontSize="11" Margin="0,0,8,0"
                                Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[FrameCaptureStart]}"
                                Command="{Binding StartFrameCaptureCommand}" />
                        <Button Style="{StaticResource FlatButton}" Padding="10,2" FontSize="11" Margin="0,0,8,0"
                                Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[FrameCaptureStop]}"
                                Command="{Binding StopFrameCaptureCommand}" />
                        <Button Style="{StaticResource FlatButton}" Padding="10,2" FontSize="11"
                                Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[FrameCaptureRefresh]}"
                                Command="{Binding RefreshFrameTargetsCommand}" />
                        <Button Style="{StaticResource FlatButton}" Padding="10,2" FontSize="11" Margin="8,0,0,0"
                                Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[RestartElevated]}"
                                ToolTip="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[ElevationHint]}"
                                Command="{Binding RestartElevatedCommand}"
                                Visibility="{Binding ShowElevationButton, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource FlatButton}" Padding="10,2" FontSize="11" Margin="8,0,0,0"
                                Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[PermissionCheckButton]}"
                                Command="{Binding OpenPermissionCheckCommand}" />
                    </StackPanel>
                    <TextBlock FontSize="11" TextWrapping="Wrap" Text="{Binding FrameCaptureText}" />
                    <TextBlock FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding FrameCaptureDetail}" />

                    <Separator Margin="0,12,0,10" Background="{DynamicResource BorderBrush}" />

                    <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                               Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[M1Notice]}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
    </ScrollViewer>
</Window>
