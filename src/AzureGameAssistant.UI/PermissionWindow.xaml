<Window x:Class="AzureGameAssistant.UI.PermissionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:AzureGameAssistant.UI.Services"
        Title="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[PermissionWindowTitle]}"
        Icon="pack://application:,,,/Assets/app-icon.ico"
        Width="640" Height="640" MinWidth="560" MinHeight="480"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Summary}" TextWrapping="Wrap" />
                <TextBlock Margin="0,2,0,0" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{Binding CheckedAt}" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource FlatButton}" VerticalAlignment="Top"
                    Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[PermissionRefresh]}"
                    Command="{Binding RefreshChecksCommand}" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,10">
                <ItemsControl ItemsSource="{Binding Checks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="20" Height="20" CornerRadius="10" VerticalAlignment="Top"
                                        Background="{Binding StatusBrush}">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="11" FontWeight="Bold" Foreground="White"
                                               Text="{Binding StatusText}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Name}" />
                                    <TextBlock Margin="0,2,0,0" FontSize="11" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="{Binding Detail}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="{Binding Hint}" />
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource FlatButton}" HorizontalAlignment="Left"
                        Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[PermissionElevate]}"
                        Command="{Binding ElevateCommand}"
                        Visibility="{Binding ShowElevateButton, Converter={StaticResource BoolToVisibility}}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource FlatButton}" Margin="0,0,8,0"
                            Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[PermissionCopyReport]}"
                            Command="{Binding CopyReportCommand}" />
                    <Button Style="{StaticResource FlatButton}" Click="OnCloseClick"
                            Content="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[PermissionClose]}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
